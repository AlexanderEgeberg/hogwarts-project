{
  "name": "api",
  "version": "1.0.0",
  "main": "index.ts",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "start": "node index.ts",
    "dev": "node --watch index.ts",
    "db:new": "dbmate new",
    "db:migrate": "dbmate up",
    "db:reset": "dbmate drop && dbmate up && yarn db:seed",
    "db:seed": "sh -c 'set -a && . ./.env && psql \"$DATABASE_URL\" -1 -v ON_ERROR_STOP=1 -f db/seed.sql'"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9",
    "@types/node": "^26.5.0",
    "@types/pg": "^8",
    "dbmate": "^2.36.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "packageManager": "yarn@4.18.0"
}
